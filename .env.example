# Groq (search bar LLM calls)
GROQ_API_KEY=placeholder

# Only needed for the "Google search" guardrail mode.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Seed account, created as an approved admin on startup. Change the password
# before deploying anywhere real — this is a username/password login with
# the password stored as a salted hash, not plaintext, but a known default
# is still a known default until changed.
ADMIN_USERNAME=group007
ADMIN_PASSWORD=P@ssw0rd12345

# Remaining users/admins sign up via the login page's "Create account" tab
# and are approved from the Admin page — no further env config needed.
